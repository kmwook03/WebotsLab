DEF AMR Robot {
  translation -2.80 -2.80 0
  children [
    Pose {
      translation 0 0 0.105
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.06 0.10 0.15
            roughness 0.55
            metalness 0.25
          }
          geometry Box { size 0.22 0.15 0.14 }
        }
      ]
    }
    Pose {
      translation 0.02 0 0.185
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.08 0.55 0.78 roughness 0.5 metalness 0 }
          geometry Box { size 0.16 0.13 0.025 }
        }
      ]
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 -0.08 0.033
      }
      device [
        RotationalMotor { name "right wheel motor" maxVelocity 10.0 }
        PositionSensor { name "right wheel sensor" resolution 0.001 }
      ]
      endPoint Solid {
        translation 0 -0.08 0.033
        rotation 1 0 0 1.5708
        children [
          DEF WHEEL_SHAPE Shape {
            appearance PBRAppearance { baseColor 0.025 0.025 0.025 roughness 1 metalness 0 }
            geometry Cylinder { height 0.020 radius 0.033 subdivision 24 }
          }
        ]
        name "right wheel"
        boundingObject Cylinder { height 0.020 radius 0.033 subdivision 16 }
        physics Physics { density -1 mass 0.04 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0.08 0.033
      }
      device [
        RotationalMotor { name "left wheel motor" maxVelocity 10.0 }
        PositionSensor { name "left wheel sensor" resolution 0.001 }
      ]
      endPoint Solid {
        translation 0 0.08 0.033
        rotation 1 0 0 1.5708
        children [ USE WHEEL_SHAPE ]
        name "left wheel"
        boundingObject Cylinder { height 0.020 radius 0.033 subdivision 16 }
        physics Physics { density -1 mass 0.04 }
      }
    }
    BallJoint {
      jointParameters BallJointParameters { anchor -0.09 0 0.014 }
      endPoint Solid {
        translation -0.09 0 0.014
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.12 0.12 0.12 roughness 1 metalness 0 }
            geometry DEF CASTER Sphere { radius 0.014 subdivision 2 }
          }
        ]
        name "caster"
        boundingObject USE CASTER
        physics Physics { density -1 mass 0.02 }
      }
    }
    Lidar {
      translation 0 0 0.215
      name "LDS-01"
      horizontalResolution 360
      fieldOfView 6.28318
      numberOfLayers 1
      near 0.07
      minRange 0.12
      maxRange 3.5
      noise 0.0043
    }
    Camera {
      translation 0.105 0 0.235
      rotation 0 1 0 0
      name "camera"
      fieldOfView 1.10
      width 160
      height 96
      near 0.03
    }
    Gyro { name "gyro" }
    Display { name "map display" width 280 height 280 }
    Emitter { name "mission emitter" channel 7 }
  ]
  name "TurtleBot3Burger"
  controller "amr_search_rescue"
  boundingObject Pose {
    translation 0 0 0.105
    children [ Box { size 0.22 0.15 0.14 } ]
  }
  physics Physics {
    density -1
    mass 0.92
    centerOfMass [ 0 0 0.08 ]
  }
}

Robot {
  translation 0 0 -0.20
  children [
    Receiver {
      name "evaluator receiver"
      channel 7
    }
  ]
  name "mission evaluator"
  controller "mission_evaluator"
  supervisor TRUE
}

