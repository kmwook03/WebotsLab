#VRML_SIM R2025a utf8

WorldInfo {
  basicTimeStep 64
  title "TECH WEEK Autonomous Search and Rescue"
  info [
    "Unknown-map AMR mission: explore, find the red rescue marker, approach, and return home."
    "The AMR has no GPS and receives no ground-truth data from the evaluator."
  ]
}
Viewpoint {
  orientation 0.3961 0.8908 0.2227 1.667
  position -8.2 -8.6 10.4
  follow "TurtleBot3Burger"
  followType "Pan and Tilt Shot"
}
Background {
  skyColor [
    0.82 0.88 0.96
  ]
}
DirectionalLight {
  ambientIntensity 0.75
  direction -0.3 -0.4 -1
  intensity 1.0
}

DEF FLOOR Solid {
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.72 0.73 0.70
        roughness 0.92
        metalness 0
      }
      geometry Box {
        size 7 7 0.1
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 7 7 0.1
  }
  locked TRUE
}

# Boundary walls.
Solid {
  translation 0 -3.5 0.25
  children [
    DEF WALL_SHAPE Shape {
      appearance DEF WALL_APPEARANCE PBRAppearance {
        baseColor 0.72 0.76 0.80
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 7.2 0.12 0.5
      }
    }
  ]
  name "south boundary"
  boundingObject Box {
    size 7.2 0.12 0.5
  }
  locked TRUE
}
Solid {
  translation 0 3.5 0.25
  children [ USE WALL_SHAPE ]
  name "north boundary"
  boundingObject Box { size 7.2 0.12 0.5 }
  locked TRUE
}
Solid {
  translation -3.5 0 0.25
  children [
    Shape {
      appearance USE WALL_APPEARANCE
      geometry Box { size 0.12 7.2 0.5 }
    }
  ]
  name "west boundary"
  boundingObject Box { size 0.12 7.2 0.5 }
  locked TRUE
}
Solid {
  translation 3.5 0 0.25
  children [
    Shape {
      appearance USE WALL_APPEARANCE
      geometry Box { size 0.12 7.2 0.5 }
    }
  ]
  name "east boundary"
  boundingObject Box { size 0.12 7.2 0.5 }
  locked TRUE
}

# Three connected baffles create occluded rooms without making a closed trap.
Solid {
  translation -1.4 -0.75 0.25
  children [
    Shape {
      appearance USE WALL_APPEARANCE
      geometry Box { size 0.15 1.5 0.5 }
    }
  ]
